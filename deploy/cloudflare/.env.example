# Copy to .env on the NAS and keep it mode 0600. Never commit the real file.

# Cloudflare remotely-managed Tunnel token. Leave empty for the local mock test.
TUNNEL_TOKEN=

# Start with mock. Change to feishu only after the Feishu redirect URL is added.
SSO_PROVIDER=mock
SSO_FEISHU_APP_ID=
SSO_FEISHU_APP_SECRET=
# Required before declaring the Feishu setup production-ready.
SSO_FEISHU_TENANT_KEY=

# These isolate the SSO-only Relay instance from any deployment Relay.
# Generate each with: openssl rand -hex 32
RELAY_SECRET=
RELAY_ADMIN_TOKEN=
