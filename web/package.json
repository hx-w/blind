{
  "name": "blind-viewer",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test src/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --base=./",
    "test:browser": "node --test tests/viewer-interactions.mjs",
    "test:collection": "node --test tests/collection-interactions.mjs",
    "test:content": "node --test --test-concurrency=1 tests/content-interactions.mjs tests/graph-depth-interactions.mjs tests/graph-interactions.mjs",
    "test:operations": "node --test tests/operations-interactions.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@viz-js/viz": "3.31.0",
    "dompurify": "3.4.16",
    "lucide": "^1.48.0",
    "marked": "18.0.14",
    "mermaid": "12.1.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
